# Local example only. Copy to a private .env in the backend working directory.
# Never commit the filled-in .env or production credentials.
SECRET_KEY=<SET_RANDOM_LOCAL_SECRET>
DATABASE_URL=sqlite+aiosqlite:///./wirelessagent-local.db
OPENCLAW_API_KEY=<SET_LOCAL_GATEWAY_TOKEN>
OPENCLAW_BASE_URL=http://127.0.0.1:18789/v1
OPENCLAW_MODEL=openclaw/default
# Optional external project; digest routes remain unavailable without it.
# ARXIV_DIGEST_DIR=C:/path/to/arxiv-wireless-digest
