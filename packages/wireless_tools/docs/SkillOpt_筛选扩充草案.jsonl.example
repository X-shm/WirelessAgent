{"id":"H14","kind":"tool_workflow","question":"为一个语音业务（保底 120 kbps、上限 240 kbps）和一个游戏业务（保底 300 kbps、上限 500 kbps）生成 5QI 导向的 QoS 建议。可用链路容量 1500 kbps，其中 80% 可承诺。再把生成的 QoS 数据交给策略校验器做容量和规则检查；目前没有实测 KPI。给出容量可行性、规则校验是否通过及工具返回的回滚标志，不把它当作现场效果验收。","source_ref":"repo:tools/qos_policy_builder.schema.json","steps":[{"tool":"qos_policy_builder","arguments":{"services":"[{\"id\":\"voice1\",\"service_type\":\"voice\",\"guaranteed_kbps\":120,\"max_kbps\":240},{\"id\":\"game1\",\"service_type\":\"gaming\",\"guaranteed_kbps\":300,\"max_kbps\":500}]","link_capacity_kbps":1500,"reserve_fraction":0.8},"expected":{"qos_data":[{"service_id":"voice1","service_type":"voice","five_qi":1,"resource_type":"GBR","priority":5,"packet_delay_budget_ms":100.0,"packet_error_rate":0.01,"gfbr_kbps":120.0,"mfbr_kbps":240.0,"decision_basis":"service_template_with_explicit_overrides"},{"service_id":"game1","service_type":"gaming","five_qi":3,"resource_type":"GBR","priority":5,"packet_delay_budget_ms":50.0,"packet_error_rate":0.001,"gfbr_kbps":300.0,"mfbr_kbps":500.0,"decision_basis":"service_template_with_explicit_overrides"}],"total_gfbr_kbps":420.0,"link_capacity_kbps":1500.0,"reserve_fraction":0.8,"capacity_feasible":true,"warning":null}},{"tool":"policy_decision_validator","arguments":{"qos_data":"[{\"service_id\":\"voice1\",\"service_type\":\"voice\",\"five_qi\":1,\"resource_type\":\"GBR\",\"priority\":5,\"packet_delay_budget_ms\":100.0,\"packet_error_rate\":0.01,\"gfbr_kbps\":120.0,\"mfbr_kbps\":240.0,\"decision_basis\":\"service_template_with_explicit_overrides\"},{\"service_id\":\"game1\",\"service_type\":\"gaming\",\"five_qi\":3,\"resource_type\":\"GBR\",\"priority\":5,\"packet_delay_budget_ms\":50.0,\"packet_error_rate\":0.001,\"gfbr_kbps\":300.0,\"mfbr_kbps\":500.0,\"decision_basis\":\"service_template_with_explicit_overrides\"}]","link_capacity_kbps":1500,"reserve_fraction":0.8},"bindings":[{"argument":"qos_data","from_step":0,"path":"/qos_data","format":"json"}],"expected":{"accepted":true,"violations":[],"total_gfbr_kbps":420.0,"reserved_capacity_kbps":1200.0,"rollback_recommended":false}}],"answer_fields":{"capacity_feasible":{"step":0,"path":"/capacity_feasible"},"accepted":{"step":1,"path":"/accepted"},"rollback_recommended":{"step":1,"path":"/rollback_recommended"}},"split":"holdout","scenario_id":"curated_H14","origin_type":"expert_authored","reviewer":"PENDING_PRODUCT_REVIEW","review_status":"draft"}
