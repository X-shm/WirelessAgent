{
  "name": "bluetooth_test_waveform_validate",
  "script": "bluetooth_test_waveform_validate.py",
  "description": "BLE RF-PHY 测试波形的 CRC、频率和 CTE IQ 测量。",
  "implementation": "纯 Python 实现 Blocking、C/I、Intermodulation、PER report integrity 的 CRC 分支；Modulation characteristics、Carrier frequency offset and drift 的频率测量；以及 IQ samples coherency/dynamic range 的 CTE IQ 测量。使用 configuration 提供 bluetoothRFPHYTestConfig 的 snake_case 属性；结果使用具名 JSON 字段而非 MATLAB 的位置输出。",
  "inputs": {
    "input": {
      "type": "string",
      "required": true,
      "description": "JSON：waveform={real,imag} 或 waveform_file=.npz；可选 test、mode、samples_per_symbol、payload_length 及 configuration 属性对象。调制特性接受两列 waveform。"
    },
    "input_file": {
      "type": "string",
      "required": false,
      "description": "与 input 互斥的 JSON 文件"
    }
  },
  "outputs": {
    "crc_error": {
      "description": "CRC/PER 判定分支的错误标志",
      "optional": true
    },
    "measurement": {
      "description": "测量分支名称",
      "optional": true
    },
    "frequency_demodulated_hz": {
      "description": "频率分支的瞬时解调频率",
      "optional": true
    },
    "relative_phase_rad": {
      "description": "IQ 相干性分支的相对相位",
      "optional": true
    },
    "mean_amplitude_reference_antennas": {
      "description": "IQ 动态范围分支的参考天线幅度",
      "optional": true
    }
  },
