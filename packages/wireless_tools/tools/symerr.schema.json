{
  "name": "symerr",
  "script": "symerr.py",
  "description": "比较符号数组，返回符号错误数、符号错误率和逐元素错误标记。",
  "implementation": "按 MATLAB Communications Toolbox symerr 的常用汇总模式独立实现。",
  "inputs": {
    "x": {
      "type": "string",
      "required": true,
      "description": "JSON 符号数组"
    },
    "y": {
      "type": "string",
      "required": true,
      "description": "JSON 符号数组"
    },
    "mode": {
      "type": "string",
      "enum": [
        "overall",
        "column-wise",
        "row-wise"
      ],
      "required": false,
      "default": "overall",
      "description": "汇总方向"
    }
  },
  "outputs": {
    "num_errors": "符号错误数",
    "error_ratio": "符号错误率",
    "individual": "逐元素错误标记"
  },
  "example": {
    "cmd": "python tools/symerr.py --x '[1,2,3]' --y '[1,3,0]'",
    "result": "{\"num_errors\":2,\"error_ratio\":0.6666666667,...}"
  }
}
