{
  "name": "lte_ul_channel_estimate",
  "script": "lte_ul_channel_estimate.py",
  "description": "使用单层 PUSCH DM-RS 估计 LTE 上行信道，对应 lteULChannelEstimate 的 Antennas 单层常用形式。",
  "implementation": "在两个 DM-RS 符号处 LS 估计，可选频域平滑，并复制到对应时隙的已分配 PRB。",
  "inputs": {
    "received_grid": {
      "type": "string",
      "required": true,
      "description": "12*NULRB×14/12×NRx 复网格"
    },
    "nulrb": {
      "type": "integer",
      "required": true,
      "description": "上行总资源块数"
    },
    "ncellid": {
      "type": "integer",
      "required": true,
      "description": "物理小区 ID"
    },
    "prb_set": {
      "type": "string",
      "required": true,
      "description": "JSON PRB 分配"
    },
    "nsubframe": {
      "type": "integer",
      "required": false,
      "default": 0,
      "description": "子帧"
    },
    "cyclic_prefix": {
      "type": "string",
      "enum": [
        "Normal",
        "Extended"
      ],
      "required": false,
      "default": "Normal",
      "description": "上行 CP"
    },
    "seq_group": {
      "type": "integer",
      "required": false,
      "default": 0,
      "description": "序列组偏移"
    },
    "sequence_index": {
      "type": "integer",
      "required": false,
      "default": 0,
      "description": "序列索引"
    },
    "cyclic_shift": {
      "type": "integer",
      "required": false,
      "default": 0,
      "description": "循环移位"
    },
    "smoothing": {
      "type": "integer",
      "required": false,
      "default": 1,
      "description": "频域平滑窗口"
    }
  },
  "outputs": {
    "channel_estimate": "完整上行复信道网格",
    "noise_variance": "DM-RS 重构残差"
  },
