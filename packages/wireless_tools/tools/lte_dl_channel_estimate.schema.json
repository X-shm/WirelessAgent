{
  "name": "lte_dl_channel_estimate",
  "script": "lte_dl_channel_estimate.py",
  "description": "使用 LTE CRS 执行下行 LS 信道估计并二维插值，对应 lteDLChannelEstimate 的 CellRS 常用形式。",
  "implementation": "内部生成端口 0..3 标准 CRS，对每个收发端口 LS 估计、可选平滑及频率/时间线性插值。",
  "inputs": {
    "received_grid": {
      "type": "string",
      "required": true,
      "description": "12*NRB×14/12×NRx 复接收网格"
    },
    "nrb": {
      "type": "integer",
      "required": true,
      "description": "下行资源块数"
    },
    "ncellid": {
      "type": "integer",
      "required": true,
      "description": "物理小区 ID"
    },
    "nsubframe": {
      "type": "integer",
      "required": false,
      "default": 0,
      "description": "子帧"
    },
    "cyclic_prefix": {
      "type": "string",
      "enum": [
        "Normal",
        "Extended"
      ],
      "required": false,
      "default": "Normal",
      "description": "循环前缀"
    },
    "ports": {
      "type": "string",
      "required": false,
      "default": "0",
      "description": "逗号 CRS 端口"
    },
    "smoothing": {
      "type": "integer",
      "required": false,
      "default": 1,
      "description": "导频频域平滑窗口"
    }
  },
  "outputs": {
    "channel_estimate": "Nsc×Nsym×NRx×NPort 复信道",
    "noise_variance": "CRS 重构残差功率",
    "ports": "估计端口"
  },
  "example": {
