  },
  "outputs": {"rms_evm": {"description": "线性 RMS EVM"}, "peak_evm": {"description": "线性峰值 EVM"}, "error_vector_grid": {"description": "归一化误差矢量复数网格"}},
  "example": {"cmd": "python tools/nr_evm.py --eq_grid '[1,1.1]' --ref_grid '[1,1]'", "result": "{\"rms_evm\": 0.07071067811865482, \"peak_evm\": 0.10000000000000009, \"error_vector_grid\": {\"real\": [0,0.1], \"imag\": [0,0]}}"}
