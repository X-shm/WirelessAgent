{"name":"lte_pmi_info","script":"lte_pmi_info.py","description":"计算 LTE PMI 报告的子带大小、子带数、最大 PMI 和码本限制位图长度，对应 ltePMIInfo。","implementation":"移植本机 R2026a 公开 ltePMIInfo.m 的参数分支和 TS 36.213 子带/码本元数据表。","inputs":{"ndlrb":{"type":"integer","required":true,"description":"下行资源块数 6..110"},"cell_ref_p":{"type":"integer","enum":[1,2,4],"required":false,"default":1,"description":"CRS 端口数"},"csi_ref_p":{"type":"integer","enum":[1,2,4,8],"required":false,"default":1,"description":"CSI-RS 端口数"},"pmi_mode":{"type":"string","enum":["Wideband","Subband"],"required":false,"default":"Wideband","description":"PMI 报告模式"},"n_layers":{"type":"integer","required":false,"default":1,"description":"传输层数"},"tx_scheme":{"type":"string","required":false,"default":"SpatialMux","description":"LTE 下行传输方案"},"alt_codebook4tx":{"type":"boolean","required":false,"default":false,"description":"启用 4Tx 替代码本"}},"outputs":{"k":"每子带 PRB 数","NSubbands":"PMI 子带数","MaxPMI":"最大 PMI 或 [i1,i2]","CodebookSubsetSize":"码本限制位图长度"},"example":{"cmd":"python tools/lte_pmi_info.py --ndlrb 50 --cell_ref_p 4 --n_layers 2 --tx_scheme SpatialMux","result":"{\"k\":50,\"NSubbands\":1,\"MaxPMI\":15,\"CodebookSubsetSize\":64}"}}
