{
  "name": "comm_interleaver_family",
  "script": "comm_interleaver_family.py",
  "description": "独立 Python 代数、卷积、复用、螺旋及螺旋扫描交织/解交织。",
  "implementation": "支持显式整型参数、零初始移位寄存器和可传递 state；输出置换或数据及寄存器状态。",
  "inputs": {
    "function": {
      "type": "enum",
      "enum": ["algintrlv", "algdeintrlv", "convintrlv", "convdeintrlv", "muxintrlv", "muxdeintrlv", "helintrlv", "heldeintrlv", "helscanintrlv", "helscandeintrlv"],
      "required": true,
      "description": "Communications Toolbox 顶层入口名"
    },
    "params": {
      "type": "string", "required": true, "max_length": 250000, "mcp_stdin": true,
      "description": "JSON 参数对象；代数交织使用 data,num,kind,k,h/alpha；移位寄存器使用 data,delay 或 nrows,slope；螺旋扫描使用 rows,columns,step。"
    }
  },
  "outputs": {
    "function": {"description": "调用的入口名"},
    "result": {"description": "交织后的数据、置换或寄存器状态"}
  },
  "example": {
    "cmd": "python tools/comm_interleaver_family.py --function helscanintrlv --params '{\"data\":[0,1,2,3,4,5],\"rows\":2,\"columns\":3,\"step\":1}'",
    "result": "交织数据和零基置换"
  }
}
