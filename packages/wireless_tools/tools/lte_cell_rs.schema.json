{"name":"lte_cell_rs","script":"lte_cell_rs.py","description":"生成 LTE 小区专用参考信号及零基 [子载波,OFDM符号,端口] 索引，对应 lteCellRS/lteCellRSIndices。","implementation":"按 3GPP TS 36.211 6.10.1 的 Gold 序列、端口 v 偏移和 vshift 映射实现端口 0..3。","inputs":{"nrb":{"type":"integer","required":true,"description":"下行资源块数 1..110"},"ncellid":{"type":"integer","required":true,"description":"物理小区 ID 0..503"},"nsubframe":{"type":"integer","required":false,"default":0,"description":"子帧 0..9"},"cyclic_prefix":{"type":"string","enum":["Normal","Extended"],"required":false,"default":"Normal","description":"循环前缀"},"ports":{"type":"string","required":false,"default":"0","description":"逗号端口 0..3"}},"outputs":{"ports":"按端口分组的索引与复参考符号","index_base":"索引基数 0"},"example":{"cmd":"python tools/lte_cell_rs.py --nrb 6 --ncellid 10 --ports 0,2","result":"{\"ports\":{\"0\":{...},\"2\":{...}},\"index_base\":0}"}}
