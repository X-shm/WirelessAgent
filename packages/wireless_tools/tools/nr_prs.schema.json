{
  "name": "nr_prs",
  "script": "nr_prs.py",
  "description": "独立 Python 生成单个活动 NR 定位参考信号资源的符号与资源网格索引。",
  "implementation": "3GPP TS 38.211 §§7.4.1.7.2/7.4.1.7.3；Gold PRBS、comb 频偏和载波网格索引。",
  "inputs": {
    "operation": {"type": "enum", "enum": ["indices", "symbols", "both"], "required": false, "default": "both", "description": "返回索引、符号或两者"},
    "nrb": {"type": "integer", "required": true, "description": "载波资源网格 RB 数"},
    "num_rb": {"type": "integer", "required": true, "description": "PRS 资源 RB 数"},
    "rb_offset": {"type": "integer", "required": false, "default": 0, "description": "PRS 资源在载波网格内的 RB 偏移"},
    "symbol_start": {"type": "integer", "required": false, "default": 0, "description": "PRS 起始 OFDM 符号"},
    "num_symbols": {"type": "integer", "required": false, "enum": [2, 4, 6, 12], "default": 12, "description": "PRS 符号数"},
    "comb_size": {"type": "integer", "required": false, "enum": [2, 4, 6, 12], "default": 2, "description": "PRS comb 间隔"},
    "re_offset": {"type": "integer", "required": false, "default": 0, "description": "第一个 PRS 符号的 comb 内偏移"},
    "nprsid": {"type": "integer", "required": false, "default": 0, "description": "PRS 序列标识"},
    "slot": {"type": "integer", "required": false, "default": 0, "description": "帧内时隙号，用于 Gold 序列初始化"},
    "index_base": {"type": "enum", "enum": ["0based", "1based"], "required": false, "default": "1based", "description": "资源网格索引基数"}
  },
  "outputs": {"n_re": {"description": "PRS RE 数"}, "indices": {"description": "载波线性索引", "optional": true}, "symbols_real": {"description": "PRS QPSK 符号实部", "optional": true}, "symbols_imag": {"description": "PRS QPSK 符号虚部", "optional": true}},
  "example": {"cmd": "python tools/nr_prs.py --nrb 4 --num_rb 2 --rb_offset 1 --num_symbols 2", "result": "{\"n_re\": 24, \"indices\": [13,15,17,...], \"symbols_real\": [...], \"symbols_imag\": [...]}"}
}
