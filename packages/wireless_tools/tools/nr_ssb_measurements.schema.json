{
  "name": "nr_ssb_measurements",
  "script": "nr_ssb_measurements.py",
  "description": "独立 Python 计算 SSB 的每接收天线 RSRP、RSSI 和 RSRQ。",
  "implementation": "3GPP TS 38.215 §§5.1.1/5.1.3；SSS/可选 PBCH DM-RS 相干相关功率、SSB 四符号 RSSI 平均。",
  "inputs": {
    "ssb_grid": {"type": "string", "required": true, "description": "复数 JSON 240×4×NRx SSB 网格；测试时可用标量填满单天线网格"},
    "ncellid": {"type": "integer", "required": true, "description": "物理小区 ID 0..1007"},
    "ibar_ssb": {"type": "integer", "required": false, "description": "提供 0..7 时将 PBCH DM-RS 纳入 RSRP"}
  },
  "outputs": {"RSRPPerAntenna": {"description": "各接收天线 RSRP，dBm"}, "RSSIPerAntenna": {"description": "各接收天线 RSSI，dBm"}, "RSRQPerAntenna": {"description": "各接收天线 RSRQ，dB"}},
  "example": {"cmd": "python tools/nr_ssb_measurements.py --ssb_grid 1 --ncellid 42", "result": "{\"RSRPPerAntenna\": [-12.076074419119138], \"RSSIPerAntenna\": [53.802112417116064], \"RSRQPerAntenna\": [-52.867886879595389]}"}
}
