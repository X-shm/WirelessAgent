{"name":"bit_int_conversion","script":"bit_int_conversion.py","description":"固定宽度比特与非负整数互转，对应 bit2int/int2bit。","implementation":"纯 NumPy，支持 MSB/LSB first。","inputs":{"mode":{"type":"string","enum":["bit_to_int","int_to_bit"],"required":true,"description":"转换方向"},"values":{"type":"string","required":true,"description":"逗号分隔值"},"width":{"type":"integer","required":true,"description":"每组比特宽度"},"bit_order":{"type":"string","enum":["msbfirst","lsbfirst"],"required":false,"default":"msbfirst","description":"位序"}},"outputs":{"values":"转换结果"},"example":{"cmd":"python tools/bit_int_conversion.py --mode bit_to_int --values 1,0,1,1 --width 2","result":"{\"values\":[2,3]}"}}
