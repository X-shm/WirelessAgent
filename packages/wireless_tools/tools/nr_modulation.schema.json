{
  "name": "nr_modulation",
  "description": "5G NR 调制/解调工具。输入比特序列映射为 QAM/PSK 复数符号，或符号序列硬判决解调为比特。支持 BPSK/pi/2-BPSK/QPSK/16QAM/64QAM/256QAM/1024QAM。",
  "implementation": "3GPP TS 38.211 §5.1，经 MATLAB 5G Toolbox nrSymbolModulate 黄金样本校验",
  "script": "nr_modulation.py",
  "inputs": {
    "mod": {
      "type": "string",
      "enum": [
        "BPSK",
        "pi/2-BPSK",
        "QPSK",
        "16QAM",
        "64QAM",
        "256QAM",
        "1024QAM"
      ],
      "required": true,
      "description": "调制方式"
    },
    "bits": {
      "type": "string",
      "required": false,
      "description": "逗号分隔的比特串，如 0,1,1,0。长度须为每符号比特数的整数倍"
    },
    "bits-hex": {
      "type": "string",
      "required": false,
      "description": "十六进制比特串（高位在前），与 bits 二选一"
    },
    "inverse": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "改为硬判决解调方向"
    },
    "symbols": {
      "type": "string",
      "required": false,
      "description": "inverse 模式的复数符号 JSON 数组"
    }
  },
  "inverse_inputs": {
    "mod": {
      "type": "string",
      "required": true,
      "description": "调制方式"
    },
    "symbols": {
      "type": "string",
      "required": true,
      "description": "复数符号 JSON 数组，如 [-0.7+0.7j, 0.7-0.7j]"
    }
  },
  "outputs": {
    "bits": "输入比特列表",
    "symbols_real": "调制符号实部（调制方向）",
    "symbols_imag": "调制符号虚部（调制方向）"
  },
  "example": {
    "cmd": "python tools/nr_modulation.py --mod QPSK --bits 1,1,0,1",
    "result": "{\"modulation\": \"QPSK\", \"bits\": [1,1,0,1], \"symbols_real\": [-0.7071, 0.7071], \"symbols_imag\": [0.7071, 0.7071]}"
  }
}
