{
  "name": "comm_analog_modulation",
  "script": "comm_analog_modulation.py",
  "description": "独立 Python AM、FM、PM 和单边带调制与相干解调。",
  "implementation": "采样实信号的解析信号解调切片；FFT 低通假设消息带宽小于截止频率，输入需满足载波低于 Nyquist。",
  "inputs": {
    "function": {
      "type": "enum",
      "enum": ["ammod", "amdemod", "fmmod", "fmdemod", "pmmod", "pmdemod", "ssbmod", "ssbdemod"],
      "required": true,
      "description": "Communications Toolbox 顶层入口名"
    },
    "params": {
      "type": "string",
      "required": true,
      "max_length": 250000,
      "mcp_stdin": true,
      "description": "JSON 参数对象：samples、carrier_hz、sample_rate，以及 freqdev_hz、phasedev、sideband、initial_phase、cutoff_hz 等对应入口参数。"
    }
  },
  "outputs": {
    "function": {"description": "调用的入口名"},
    "result": {"description": "调制或解调后的 samples"}
  },
  "example": {
    "cmd": "python tools/comm_analog_modulation.py --function ammod --params '{\"samples\":[1,0,-1,0],\"carrier_hz\":1,\"sample_rate\":8}'",
    "result": "{\"function\":\"ammod\",\"result\":{\"samples\":[1.0,0.0,0.0,-0.0]}}"
  }
}
