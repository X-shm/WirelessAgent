{
  "name": "biterr",
  "script": "biterr.py",
  "description": "比较非负整数的二进制表示，返回比特错误数、误比特率和逐元素错误数。",
  "implementation": "按 MATLAB Communications Toolbox biterr 的位宽和 overall/row-wise/column-wise 规则独立实现。",
  "inputs": {
    "x": {
      "type": "string",
      "required": true,
      "description": "JSON 非负整数数组"
    },
    "y": {
      "type": "string",
      "required": true,
      "description": "JSON 非负整数数组"
    },
    "k": {
      "type": "integer",
      "required": false,
      "description": "每个元素使用的比特数"
    },
    "mode": {
      "type": "string",
      "enum": [
        "overall",
        "column-wise",
        "row-wise"
      ],
      "required": false,
      "default": "overall",
      "description": "汇总方向"
    }
  },
  "outputs": {
    "num_errors": "比特错误数",
    "error_ratio": "误比特率",
    "individual": "逐元素错误比特数",
    "k": "实际位宽"
  },
  "example": {
    "cmd": "python tools/biterr.py --x '[1,2,3]' --y '[1,3,0]' --k 2",
    "result": "{\"num_errors\":3,\"error_ratio\":0.5,...}"
  }
}
