{
  "name": "nr_csi_resources",
  "script": "nr_csi_resources.py",
  "description": "独立 Python 单端口 CSI 资源及宽带质量估计子集；CQI 为 Shannon 界近似，不等同 MATLAB 的完整码本报告。",
  "implementation": "Standalone NumPy implementation; explicit limited coverage in tool_registry.json.",
  "inputs": {
    "function": {
      "type": "enum",
      "enum": [
        "nrCSIMeasurementsSRS",
        "nrCSIReportCSIRS",
        "nrCSIRSIndices",
        "nrCSIRSMeasurements"
      ],
      "required": true,
      "description": "MATLAB 5G Toolbox 入口名"
    },
    "params": {
      "type": "string",
      "required": true,
      "max_length": 250000,
      "mcp_stdin": true,
      "description": "JSON 对象字符串。CSIRSIndices: nrb,symbol,subcarrier_offset,density,index_base；CSIRSMeasurements: grid,indices,nrb,index_base；CSIReportCSIRS/CSIMeasurementsSRS: channel,noise_variance。"
    }
  },
  "outputs": {
    "function": {
      "description": "调用的 MATLAB 入口名"
    },
    "result": {
      "description": "该入口的结构化计算结果"
    }
  },
  "example": {
    "cmd": "python tools/nr_csi_resources.py --function nrCSIRSIndices --params '{\"nrb\":2}'",
    "result": "按入口参数返回 JSON 对象；缺失必需参数时返回 error"
  }
}
