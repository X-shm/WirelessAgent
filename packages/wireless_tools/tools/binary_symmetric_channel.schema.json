      "required": false,
      "description": "随机种子"
    }
  },
  "outputs": {
    "output": "信道输出",
    "errors": "错误掩码",
    "observed_probability": "观测翻转率"
  },
  "example": {
    "cmd": "python tools/binary_symmetric_channel.py --data '[0,1,0,1]' --probability 0.1 --seed 1",
