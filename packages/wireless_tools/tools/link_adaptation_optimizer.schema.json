{"name":"link_adaptation_optimizer","script":"link_adaptation_optimizer.py","description":"根据测量 SNR、保守裕量和资源约束推荐 LTE MCS、调制和 TBS。","implementation":"启发式 SNR 门限只负责保守选档，最终 ITBS、调制和传输块大小复用已验证 lteMCS/lteTBS 官方表。","inputs":{"snr_db":{"type":"number","required":true,"description":"测量 SNR dB"},"nprb":{"type":"integer","required":true,"description":"分配 PRB 数"},"table":{"type":"string","enum":["PDSCH","PDSCHTable2","PDSCHTable3","PUSCH"],"required":false,"default":"PDSCH","description":"MCS 表"},"layers":{"type":"integer","required":false,"default":1,"description":"空间层数"},"margin_db":{"type":"number","required":false,"default":2,"description":"实现/衰落裕量"},"min_mcs":{"type":"integer","required":false,"default":0,"description":"最低 MCS"},"max_mcs":{"type":"integer","required":false,"default":28,"description":"最高 MCS"},"bler_target":{"type":"number","required":false,"default":0.1,"description":"目标 BLER 记录值"}},"outputs":{"recommended_mcs":"推荐 MCS","itbs":"TBS 索引","modulation":"调制","tbs_bits_per_subframe":"每子帧 TBS","estimated_peak_mbps":"峰值速率估计"},"example":{"cmd":"python tools/link_adaptation_optimizer.py --snr_db 15 --nprb 25 --margin_db 2","result":"{\"recommended_mcs\":16,\"modulation\":\"64QAM\",...}"}}
