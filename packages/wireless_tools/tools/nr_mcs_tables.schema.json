{
  "name": "nr_mcs_tables",
  "script": "nr_mcs_tables.py",
  "description": "5G NR MCS 和 CQI 查询表。根据 TS 38.214 Tables 5.1.3.1-1..4 查询调制阶数、目标码率和频谱效率。",
  "implementation": "3GPP TS 38.214 §5.1.3.1，支持 PDSCH MCS 表 1-4 和 CQI 表",
  "inputs": {
    "table": {"type": "string", "required": false, "default": "QAM64Table", "enum": ["QAM64Table", "QAM256Table", "QAM64LowSETable", "QAM1024Table"], "description": "要查询的 MCS 表"},
    "mcs": {"type": "integer", "required": false, "description": "可选：只查询一个 MCS 索引"}
  },
  "outputs": {
    "table_name": {"description": "表名称"},
    "entries": {"description": "表项数量"},
    "mcs_index": {"description": "MCS 索引列表"},
    "modulation": {"description": "调制方式列表"},
    "qm": {"description": "调制阶数列表"},
    "target_code_rate": {"description": "目标码率列表"},
    "spectral_efficiency": {"description": "频谱效率列表"}
  },
  "example": {
    "cmd": "python tools/nr_mcs_tables.py",
    "result": "{\"table_name\": \"QAM64Table\", \"entries\": 32, \"mcs_index\": [0,1,2,...], \"modulation\": [\"QPSK\",...]}"
  }
}
