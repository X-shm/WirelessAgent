{
  "name": "lte_cell_search",
  "script": "lte_cell_search.py",
  "description": "由资源网格中已提取的 PSS/SSS 检测 LTE NID2/NID1 和物理小区 ID，对应 lteCellSearch 的网格域形式。",
  "implementation": "对 3 个 PSS 根序列及匹配 NID2 的 168 个 SSS 候选做归一化相关。",
  "inputs": {
    "observed_pss": {
      "type": "string",
      "required": true,
      "description": "62 个观测复 PSS 符号"
    },
    "observed_sss": {
      "type": "string",
      "required": false,
      "description": "62 个观测复 SSS 符号"
    },
    "sss_subframe": {
      "type": "integer",
      "enum": [
        0,
        5
      ],
      "required": false,
      "description": "已知 SSS 子帧；省略时同时搜索 0/5"
    }
  },
  "outputs": {
    "nid2": "PSS 小区组内 ID",
    "nid1": "SSS 小区组 ID",
    "ncellid": "物理小区 ID",
    "pss_score": "归一化相关分数",
    "sss_score": "归一化相关分数"
  },
