{"name":"link_capacity","script":"link_capacity.py","description":"计算 SISO 或多子载波 MIMO Shannon 容量，作为网络优化前后的理论上界基线。","implementation":"SISO 使用 log2(1+SNR)，MIMO 使用等功率 log2 det(I+SNR/Nt·HHᴴ)，对子载波取平均。","inputs":{"snr_db":{"type":"number","required":true,"description":"接收 SNR dB"},"bandwidth_hz":{"type":"number","required":true,"description":"带宽 Hz"},"channel":{"type":"string","required":false,"description":"[NRx,NTx] 或 [Nsc,NRx,NTx] 复信道"}},"outputs":{"spectral_efficiency_bps_hz":"频谱效率","capacity_bps":"容量上界","spatial_stream_limit":"空间流上限"},"example":{"cmd":"python tools/link_capacity.py --snr_db 0 --bandwidth_hz 1000000","result":"{\"spectral_efficiency_bps_hz\":1.0,\"capacity_bps\":1000000.0}"}}
