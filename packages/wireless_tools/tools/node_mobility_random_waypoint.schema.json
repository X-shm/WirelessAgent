{"name":"node_mobility_random_waypoint","script":"node_mobility_random_waypoint.py","description":"在矩形/圆形边界内生成随机航点轨迹。","implementation":"nodeMobilityRandomWaypoint 的无状态离散时间形式。","inputs":{"initial_position":{"type":"string","required":true,"description":"x,y,z"},"duration":{"type":"number","required":true,"description":"总时长"},"time_step":{"type":"number","required":false,"default":1,"description":"采样间隔"},"speed_range":{"type":"string","required":false,"default":"0.415,1.66","description":"最小,最大速度"},"pause_duration":{"type":"number","required":false,"default":0,"description":"航点暂停时间"},"boundary_shape":{"type":"string","enum":["rectangle","circle"],"required":false,"default":"rectangle","description":"边界"},"bounds":{"type":"string","required":false,"default":"0,0,10,10","description":"矩形 cx,cy,L,W 或圆 cx,cy,R"},"seed":{"type":"integer","required":false,"description":"随机种子"}},"outputs":{"times":"时间","positions":"位置","velocities":"速度"},"example":{"cmd":"python tools/node_mobility_random_waypoint.py --initial_position 0,0,0 --duration 10 --seed 1","result":"{\"positions\":[...]}"}}
