{"name":"lte_pdsch_prbs","script":"lte_pdsch_prbs.py","description":"生成 LTE PDSCH 码字扰码 Gold 序列及 cinit，对应 ltePDSCHPRBS。","implementation":"使用 RNTI、码字号、子帧和小区 ID 的 TS 36.211 初始化公式；支持任意零基起始位置及 binary/signed 映射。","inputs":{"ncellid":{"type":"integer","required":true,"description":"物理小区 ID"},"nsubframe":{"type":"integer","required":true,"description":"子帧 0..9"},"rnti":{"type":"integer","required":true,"description":"16 位 RNTI"},"codeword":{"type":"integer","enum":[0,1],"required":true,"description":"码字号"},"length":{"type":"integer","required":true,"description":"输出长度"},"start":{"type":"integer","required":false,"default":0,"description":"零基序列起点"},"mapping":{"type":"string","enum":["binary","signed"],"required":false,"default":"binary","description":"输出映射"}},"outputs":{"sequence":"扰码序列","cinit":"Gold 序列初值","start":"起始位置"},"example":{"cmd":"python tools/lte_pdsch_prbs.py --ncellid 42 --nsubframe 7 --rnti 321 --codeword 0 --length 16","result":"{\"sequence\":[...],\"cinit\":...}"}}
