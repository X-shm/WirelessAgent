    "input_file": {
      "type": "string",
      "required": false,
      "description": "与 input 互斥的 JSON 文件"
    }
  },
  "outputs": {
    "configuration": {
      "description": "规范化频跳配置",
      "optional": true
    },
    "channel_index": "0..78 经典蓝牙通道",
    "x": "PHY 白化控制值"
  },
  "example": {
    "cmd": "python tools/bluetooth_frequency_hop.py --input '{\"clock\":\"2C\",\"configuration\":{\"sequence_type\":\"Connection basic\",\"device_address\":\"2A96EF25\"}}'",
