{"name":"lte_sync_indices","script":"lte_sync_indices.py","description":"生成 FDD LTE PSS/SSS 资源网格索引，对应 ltePSSIndices/lteSSSIndices 的 FDD 常用形式。","implementation":"支持 Normal/Extended CP、子帧 0/5、零基或一基下标形式。","inputs":{"nrb":{"type":"integer","required":true,"description":"下行资源块数 6..110"},"nsubframe":{"type":"integer","required":false,"default":0,"description":"子帧 0..9"},"cyclic_prefix":{"type":"string","enum":["Normal","Extended"],"required":false,"default":"Normal","description":"循环前缀"},"signal":{"type":"string","enum":["pss","sss","both"],"required":false,"default":"both","description":"信号选择"},"index_base":{"type":"integer","enum":[0,1],"required":false,"default":0,"description":"索引基数"}},"outputs":{"pss":"PSS [子载波,符号,端口]","sss":"SSS [子载波,符号,端口]","index_base":"索引基数"},"example":{"cmd":"python tools/lte_sync_indices.py --nrb 6 --nsubframe 0","result":"{\"pss\":[[5,6,0],...],\"sss\":[[5,5,0],...]}"}}
