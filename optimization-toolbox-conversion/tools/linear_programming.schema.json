{
  "name": "linear_programming",
  "script": "linear_programming.py",
  "description": "求解线性目标、线性等式/不等式约束和变量边界组成的线性规划；对应 MATLAB linprog。",
  "inputs": {
    "problem": {"type": "string", "required": true, "description": "JSON 对象：必需 c；可选 A_ub/b_ub、A_eq/b_eq、bounds。"},
    "options": {"type": "string", "required": false, "description": "可选 JSON 对象：max_iterations、tolerance、display。"}
  },
  "outputs": {"x": "最优变量或无可行解时 null", "objective": "目标函数值或 null", "success": "求解是否成功", "status": "求解器状态码", "message": "求解信息", "iterations": "迭代次数", "method": "HiGHS 线性规划算法"},
  "example": {"cmd": "python tools/linear_programming.py --problem '{\"c\":[1,2],\"A_ub\":[[1,1]],\"b_ub\":[4],\"bounds\":[[0,null],[0,null]]}'", "result": "{\"x\":[0.0,0.0],\"objective\":0.0,\"success\":true}"}
}
